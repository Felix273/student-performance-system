# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
# Optional direct, non-pooled URL for Prisma migrations (recommended for Neon).
# Use the direct host (without "-pooler") and keep DATABASE_URL for app traffic.
# DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST:5432/DATABASE?sslmode=require"
# DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@DIRECT_HOST:5432/DATABASE?sslmode=require"

# NextAuth session encryption and application URL
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Optional AI performance analysis
ANTHROPIC_API_KEY=""

# Optional production email delivery using Gmail SMTP (no custom domain needed)
# Enable 2-Step Verification and create an App Password in your Google Account.
# EMAIL_PROVIDER="gmail"
# GMAIL_USER="your-account@gmail.com"
# GMAIL_APP_PASSWORD="your-16-character-app-password"
# EMAIL_FROM="Fentech StudentOS <your-account@gmail.com>"

# Alternative: Resend (requires a domain verified with Resend)
# EMAIL_PROVIDER="resend"
# RESEND_API_KEY="re_..."
# EMAIL_FROM="Fentech StudentOS <accounts@mail.yourdomain.com>"
